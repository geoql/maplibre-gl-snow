{
  "name": "@geoql/maplibre-gl-snow",
  "version": "0.0.12",
  "private": false,
  "description": "A MapLibre GL JS custom layer for rendering falling snow particles via Three.js WebGPU compute shaders",
  "keywords": [
    "layer",
    "maplibre",
    "particles",
    "snow",
    "three.js",
    "weather",
    "webgpu"
  ],
  "homepage": "https://maplibre-gl-snow.geoql.in",
  "bugs": {
    "url": "https://github.com/geoql/maplibre-gl-snow/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/maplibre-gl-snow.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run",
    "prepare": "is-ci || husky",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint && pnpm --filter ./example run typecheck",
    "demo:dev": "pnpm --filter ./example run dev",
    "demo:build": "pnpm --filter ./example run build",
    "deploy": "pnpm --filter ./example run deploy",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "pnpm dlx jsr publish"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "maplibre-gl": "^6.15.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  },
  "peerDependencies": {
    "maplibre-gl": ">=3.0.0",
    "three": ">=0.183.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
